# PCS Validation Test Suite - API Keys Configuration
#
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to git (it's in .gitignore)
#
# See API_KEYS_SETUP.md for detailed instructions

# ============================================================================
# REQUIRED: Anthropic API Key (Claude)
# ============================================================================
# Used by: Most tests (24/25)
# Get your key at: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_key_here

# ============================================================================
# REQUIRED FOR EVS-7: OpenAI API Key (Embeddings)
# ============================================================================
# Used by: EVS-7 (Semantic Retrieval) for embedding generation
# Get your key at: https://platform.openai.com/
# Format: sk-proj-... or sk-...
# ⚠️ IMPORTANT: This must be an OpenAI key, NOT a Groq key!
OPENAI_API_KEY=your_openai_key_here

# ============================================================================
# OPTIONAL: Groq API Key (Llama)
# ============================================================================
# Used by: EVS-3 (Engine Replacement) for Llama fallback testing
# Get your key at: https://console.groq.com/
# Format: gsk_...
# Note: Test will skip Llama portion if not set
GROQ_API_KEY=your_groq_key_here

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace placeholder values with your actual API keys
# 3. Verify setup: npm run preflight
# 4. Run tests: npm run test:quick
#
# For detailed instructions, see: API_KEYS_SETUP.md
#
# SECURITY REMINDER:
# - Never commit .env to git
# - Never share your API keys
# - Rotate keys periodically
# - Use separate keys for development and production
